{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "AI_API_KEY",
    "AI_BASE_URL",
    "AI_MODEL",
    "AI_MODEL_CONTEXT_WINDOW",
    "AI_PROVIDER",
    "AI_PROVIDER_NAME",
    "ANTHROPIC_API_KEY",
    "AUTH_INSTANCE_ID",
    "AUTH_SESSION_TTL_DAYS",
    "CLOUDFLARED_COMMAND",
    "CLOUDFLARED_TOKEN",
    "DATABASE_PATH",
    "EVE_NEXT_PRODUCTION_ORIGIN",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "KERNEL_API_KEY",
    "LINQ_API_KEY",
    "LINQ_PHONE_NUMBER",
    "LINQ_WEBHOOK_SECRET",
    "OPENAI_API_KEY",
    "OWNER_PHONE_NUMBER",
    "PORT",
    "PUBLIC_URL",
    "SECRET_ENCRYPTION_KEY",
    "TAILSCALE_COMMAND",
    "TAILSCALE_FUNNEL_HOSTNAME",
    "TUNNEL_PROVIDER",
    "ZROK_COMMAND",
    "VAULT_ENCRYPTION_KEY",
    "ZROK_RESERVED_SHARE"
  ],
  "tasks": {
    "build:app": {
      "dependsOn": ["^build:app"],
      "outputs": [".next/**", "!.next/cache/**", "next-env.d.ts"]
    },
    "dev:app": {
      "cache": false,
      "persistent": true
    },
    "format:check": {
      "outputs": []
    },
    "knip": {
      "outputs": []
    },
    "lint:app": {
      "outputs": []
    },
    "start:app": {
      "cache": false,
      "persistent": true
    },
    "test:app": {
      "outputs": []
    },
    "types:generate": {
      "outputs": [".next/types/**", "next-env.d.ts"]
    },
    "types:check:app": {
      "dependsOn": ["types:generate"],
      "outputs": ["*.tsbuildinfo"]
    }
  }
}
