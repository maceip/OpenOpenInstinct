# Stable HTTPS origin exposed by the selected tunnel. Do not use a Quick Tunnel URL.
PUBLIC_URL=https://assistant.example.com

# Generate both values once and preserve them across upgrades and hostname changes.
# AUTH_INSTANCE_ID must be a 16-128 character base64url value.
AUTH_INSTANCE_ID=
# Base64-encoded 32-byte key.
SECRET_ENCRYPTION_KEY=

# Local SQLite database. The parent directory is created automatically.
DATABASE_PATH=.data/openopeninstinct.sqlite
AUTH_SESSION_TTL_DAYS=30

# Direct model provider: openai, anthropic, google, or openai-compatible.
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
AI_MODEL_CONTEXT_WINDOW=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_PROVIDER_NAME=

# Kernel browser runtime.
KERNEL_API_KEY=

# Linq owner channel and one-click device recovery delivery.
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_PHONE_NUMBER=
OWNER_PHONE_NUMBER=

# Select with: pnpm self-host -- --tunnel=cloudflare|tailscale|zrok|none
TUNNEL_PROVIDER=none
CLOUDFLARED_TOKEN=
TAILSCALE_FUNNEL_HOSTNAME=
ZROK_RESERVED_SHARE=

# Optional executable overrides when a tunnel CLI is not on PATH.
CLOUDFLARED_COMMAND=
TAILSCALE_COMMAND=
ZROK_COMMAND=

# Optional public Eve origin override.
EVE_NEXT_PRODUCTION_ORIGIN=

# Development benchmarks only (pnpm bench:browser).
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1
